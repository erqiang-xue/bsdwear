# Permanent Decart API key from https://platform.decart.ai
# The server exchanges this for a short-lived client token.
# Never put a dct_* key in browser code or commit a real value.
DECART_API_KEY=

# Optional. Express listens here; Vite dev proxies /api to this port.
PORT=3001

# Local account database, opened by Node's built-in node:sqlite.
# Defaults to data/auth.sqlite in this repo. No native module is compiled.
# AUTH_DB_PATH=data/auth.sqlite

# Create the first admin on startup only when AUTH_SEED=1 and that username
# does not exist yet. Leave this off after the account exists. The password
# must be at least 8 characters. Do not commit a real password.
# AUTH_SEED=1
# AUTH_SEED_USERNAME=demo
# AUTH_SEED_PASSWORD=

# Session length in days. Default is 7. There is no refresh token.
# SESSION_DAYS=7

# Cookie flags. SameSite defaults to lax. Secure defaults to auto
# (on when the request is HTTPS, including X-Forwarded-Proto).
# Keep lax (or none) so the browser sends the short-lived bw_oauth cookie
# when User Center redirects back. strict drops that cookie.
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=auto

# User Center login. Default off: the username and password form stays as it is.
# Turn it on only when this app should send people to the hosted login page
# (OAuth 2.0 authorization code + S256 PKCE) and then set bw_session / bw_csrf.
# bsdwear is a public PKCE client. There is no client secret.
# Do not copy password hashes to User Center. allow_self_register stays false
# in User Center; this app also does not add a public signup.
# USER_CENTER_ENABLED=false
# USER_CENTER_BASE_URL=http://127.0.0.1:43123
# USER_CENTER_CLIENT_ID=bsdwear
# Browser origin for the local demo (Vite). npm start on port 3001 is also allowed
# while this origin is a loopback address.
# USER_CENTER_PUBLIC_URL=http://127.0.0.1:5173
# Callback path. Do not put a production origin in this file.
# USER_CENTER_REDIRECT_PATH=/auth/oauth/callback
# Comma-separated extra callback URLs this app may send. Empty by default.
# This is not User Center's OAUTH_EXTRA_REDIRECT_URIS (that one is a JSON object
# set on the User Center process, not committed here).
# USER_CENTER_EXTRA_REDIRECT_URIS=
