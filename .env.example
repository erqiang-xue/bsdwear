# Permanent Decart API key from https://platform.decart.ai
# The server exchanges this for a short-lived client token.
# Never put a dct_* key in browser code or commit a real value.
DECART_API_KEY=

# Optional. Express listens here; Vite dev proxies /api to this port.
PORT=3001

# Local account database. Defaults to data/auth.sqlite in this repo.
# AUTH_DB_PATH=data/auth.sqlite

# Create the first admin on startup only when AUTH_SEED=1 and that username
# does not exist yet. Leave this off after the account exists. The password
# must be at least 8 characters. Do not commit a real password.
# AUTH_SEED=1
# AUTH_SEED_USERNAME=demo
# AUTH_SEED_PASSWORD=

# Session length in days. Default is 7. There is no refresh token.
# SESSION_DAYS=7

# Cookie flags. SameSite defaults to lax. Secure defaults to auto
# (on when the request is HTTPS, including X-Forwarded-Proto).
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=auto
